# 本地开发环境变量模板（C2/C3，部署适配方案 §5）
# 用法：复制为 .env（.env 已被 .gitignore 排除，不会入库）或直接在启动前注入；
# 服务本身不自动加载 .env，启动前需注入到进程环境（PowerShell：$env:X='y'）。
# 服务端启动脚本示例：set -a; . ./.env; set +a; python run.py

# 必填：PostgreSQL 连接串（生产使用全新强密码，勿沿用任何已泄露口令）
MINE_PG_DSN=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/mine_platform

# 必填：JWT 签名密钥（生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）
MINE_JWT_SECRET=CHANGE_ME_RANDOM_48B+

# 可选
MINE_PORT=8000
MINE_PG_TZ=Asia/Shanghai
# MINE_SEED_BASE=1        # 生产首启写入基础数据（品种/当日基准价/港口现货价，不含任何账号与企业）；幂等可保留
# MINE_SEED_DEMO=1        # 仅本地/测试环境写入演示种子数据；生产留空
# MINE_DISABLE_JOBS=1     # 生产 Web 进程必须设置（定时任务改由独立进程调度）
# MINE_UPLOAD_DIR=        # 上传目录覆盖（默认 项目根/uploads）
